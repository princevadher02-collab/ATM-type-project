
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>ATM | Verify Account</title>

  <style>

    /* =========================
       RESET
    ========================= */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --cyan: #00eaff;
      --blue: #1677ff;
      --purple: #8b5cf6;

      --bg: #05070d;
      --text: #f1f5f9;
      --muted: #7d8ba1;

      --border: rgba(0, 234, 255, 0.25);
    }


    /* =========================
       BODY
    ========================= */

    body {

      min-height: 100vh;

      display: flex;
      justify-content: center;
      align-items: center;

      padding: 25px;

      font-family:
        "Segoe UI",
        Arial,
        sans-serif;

      color: var(--text);

      background:

        radial-gradient(
          circle at 15% 20%,
          rgba(0, 234, 255, 0.10),
          transparent 30%
        ),

        radial-gradient(
          circle at 85% 80%,
          rgba(139, 92, 246, 0.12),
          transparent 30%
        ),

        #05070d;

      overflow: hidden;
    }


    /* =========================
       BACKGROUND GRID
    ========================= */

    body::before {

      content: "";

      position: fixed;

      inset: 0;

      background-image:

        linear-gradient(
          rgba(0, 234, 255, 0.035) 1px,
          transparent 1px
        ),

        linear-gradient(
          90deg,
          rgba(0, 234, 255, 0.035) 1px,
          transparent 1px
        );

      background-size: 45px 45px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent
        );

      pointer-events: none;
    }


    /* =========================
       MAIN CARD
    ========================= */

    .container {

      position: relative;

      width: 420px;
      max-width: 100%;

      padding: 38px;

      background:

        linear-gradient(
          145deg,
          rgba(20, 30, 48, 0.95),
          rgba(7, 12, 22, 0.96)
        );

      border:
        1px solid var(--border);

      border-radius: 24px;

      box-shadow:

        0 30px 80px
        rgba(0, 0, 0, 0.55),

        0 0 35px
        rgba(0, 234, 255, 0.08);

      backdrop-filter: blur(20px);

      animation:
        cardIn 0.7s ease;
    }


    @keyframes cardIn {

      from {

        opacity: 0;

        transform:
          translateY(35px)
          scale(0.96);
      }

      to {

        opacity: 1;

        transform:
          translateY(0)
          scale(1);
      }
    }


    /* =========================
       TOP LINE
    ========================= */

    .top-line {

      width: 45px;

      height: 4px;

      border-radius: 10px;

      background:
        var(--cyan);

      box-shadow:
        0 0 10px var(--cyan);

      margin-bottom: 22px;
    }


    /* =========================
       HEADER
    ========================= */

    .header {

      margin-bottom: 32px;
    }


    .header small {

      display: block;

      margin-bottom: 7px;

      color:
        var(--cyan);

      font-size: 11px;

      letter-spacing: 3px;

      font-weight: 700;
    }


    h2 {

      font-size: 30px;

      font-weight: 700;

      color: white;
    }


    .subtitle {

      margin-top: 8px;

      color:
        var(--muted);

      font-size: 13px;

      line-height: 1.5;
    }


    /* =========================
       FORM
    ========================= */

    form {

      display: flex;

      flex-direction: column;

      gap: 21px;
    }


    .field {

      display: flex;

      flex-direction: column;

      gap: 9px;
    }


    /* =========================
       LABEL
    ========================= */

    label {

      color:
        #cbd5e1;

      font-size: 12px;

      font-weight: 600;

      letter-spacing: 0.8px;

      text-transform: uppercase;
    }


    /* =========================
       INPUT
    ========================= */

    .input-box {

      position: relative;
    }


    .input-box span {

      position: absolute;

      left: 16px;

      top: 50%;

      transform:
        translateY(-50%);

      color:
        #64748b;

      font-size: 16px;

      pointer-events: none;

      transition: 0.3s;
    }


    input {

      width: 100%;

      height: 52px;

      padding:
        0 16px 0 43px;

      border-radius: 11px;

      border:
        1px solid
        rgba(148, 163, 184, 0.16);

      outline: none;

      background:
        rgba(3, 8, 18, 0.75);

      color: white;

      font-size: 14px;

      transition:
        border 0.3s,
        box-shadow 0.3s,
        background 0.3s;
    }


    input::placeholder {

      color:
        #475569;
    }


    input:focus {

      border-color:
        rgba(0, 234, 255, 0.7);

      background:
        rgba(0, 234, 255, 0.035);

      box-shadow:

        0 0 0 3px
        rgba(0, 234, 255, 0.07),

        0 0 18px
        rgba(0, 234, 255, 0.08);
    }


    input:focus + span {

      color:
        var(--cyan);

      text-shadow:
        0 0 8px var(--cyan);
    }


    /* =========================
       VERIFY INFO
    ========================= */

    .verify-info {

      display: flex;

      justify-content: space-between;

      align-items: center;

      margin-top: -5px;

      color:
        #526176;

      font-size: 11px;
    }


    .secure {

      display: flex;

      align-items: center;

      gap: 6px;

      color:
        #22c55e;
    }


    .secure-dot {

      width: 6px;

      height: 6px;

      border-radius: 50%;

      background:
        #22c55e;

      box-shadow:
        0 0 8px #22c55e;
    }


    /* =========================
       BUTTON
    ========================= */

    button {

      position: relative;

      width: 100%;

      height: 54px;

      margin-top: 7px;

      border: none;

      border-radius: 11px;

      background:

        linear-gradient(
          100deg,
          #00c6ff,
          #0072ff
        );

      color:
        #021018;

      font-size: 14px;

      font-weight: 800;

      letter-spacing: 1px;

      cursor: pointer;

      overflow: hidden;

      box-shadow:

        0 8px 25px
        rgba(0, 114, 255, 0.25);

      transition:
        transform 0.25s,
        box-shadow 0.25s;
    }


    /* =========================
       BUTTON LIGHT
    ========================= */

    button::before {

      content: "";

      position: absolute;

      top: 0;

      left: -120%;

      width: 80%;

      height: 100%;

      background:

        linear-gradient(
          90deg,
          transparent,
          rgba(255,255,255,0.5),
          transparent
        );

      transform:
        skewX(-25deg);

      transition:
        0.6s;
    }


    button:hover {

      transform:
        translateY(-2px);

      box-shadow:

        0 12px 30px
        rgba(0, 234, 255, 0.25),

        0 0 20px
        rgba(0, 234, 255, 0.12);
    }


    button:hover::before {

      left: 130%;
    }


    button:active {

      transform:
        translateY(1px)
        scale(0.99);
    }


    /* =========================
       FOOTER
    ========================= */

    .footer {

      margin-top: 25px;

      padding-top: 18px;

      border-top:
        1px solid
        rgba(148, 163, 184, 0.08);

      display: flex;

      justify-content: space-between;

      color:
        #526176;

      font-size: 10px;

      letter-spacing: 0.6px;
    }


    .footer span:last-child {

      color:
        #64748b;
    }


    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 500px) {

      body {
        padding: 18px;
      }

      .container {

        padding:
          30px 24px;

        border-radius: 20px;
      }

      h2 {

        font-size: 26px;
      }
    }


    @media (max-width: 350px) {

      .container {

        padding:
          25px 18px;
      }

      h2 {

        font-size: 23px;
      }

      input {

        height: 49px;
      }

      button {

        height: 50px;
      }
    }

  </style>
</head>


<body>

  <div class="container">

    <div class="top-line"></div>


    <div class="header">

      <small>ATM • AUTHENTICATION SYSTEM</small>

      <h2>Login Account</h2>

      <p class="subtitle">
        Verify your account before continuing with the transaction.
      </p>

    </div>


    <form method="POST" action="/user/credit/login">

      <!-- USERNAME -->

      <div class="field">

        <label for="username">
          User Name
        </label>

        <div class="input-box">

          <input
            type="text"
            id="username"
            name="name"
            placeholder="Enter your username"
            autocomplete="username"
            required
          >

          <span>◉</span>

        </div>

      </div>


      <!-- PASSWORD -->

      <div class="field">

        <label for="password">
          Password / PIN
        </label>

        <div class="input-box">

          <input
            type="password"
            id="password"
            name="password"
            minlength="4"
            maxlength="4"
            inputmode="numeric"
            placeholder="Enter your password"
            autocomplete="current-password"
            required
          >

          <span>◆</span>

        </div>

      </div>


      <!-- INFO -->

      <div class="verify-info">

        <span>Secure verification</span>

        <span class="secure">

          <i class="secure-dot"></i>

          Protected

        </span>

      </div>


      <!-- BUTTON -->

      <button type="submit">
        LOGIN ACCOUNT
      </button>

    </form>
<% if (locals.message) { %>
        <script>
            alert("<%= message %>");
        </script>
    <% } %>

    <div class="footer">

      <span>ATM SYSTEM v2.0</span>

      <span>SECURE ACCESS</span>

    </div>

  </div>

</body>

</html>

